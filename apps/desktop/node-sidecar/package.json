{
  "name": "@auditpoppy/desktop-sidecar",
  "version": "0.1.0",
  "license": "PolyForm-Shield-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:lambda": "node scripts/build-lambda-bundle.mjs",
    "gen:manifest": "tsx scripts/build-manifest.ts",
    "build": "npm run gen:lambda && node scripts/build-backend-bundle.mjs",
    "pretest": "npm run gen:lambda",
    "test": "node --import tsx --test src/*.test.ts",
    "pretypecheck": "npm run gen:lambda",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@auditpoppy/core": "*",
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-cloudtrail": "^3.700.0",
    "@aws-sdk/client-config-service": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.1124.0",
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-pricing": "^3.700.0",
    "@aws-sdk/client-rds": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-securityhub": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
